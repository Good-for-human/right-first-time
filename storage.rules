rules_version = '2';

// Mirror of firestore.rules path policy: every Storage object lives under
//   /users/{uid}/...
// and only the authenticated owner of that uid may read or write it.
//
// AI-generated images are stored under
//   users/{uid}/tasks/{taskId}/ai-images/<filename>.png
// — this rule covers that path and any future per-user folders.
service firebase.storage {
  match /b/{bucket}/o {

    // Task attachment area — users may drop / paste ANY content type here
    // (images, PDFs, docs, …). Still owner-only and size-capped. This rule is
    // unioned with the image-only rule below; Storage grants access if any
    // matching rule allows, so non-image attachments succeed only on this path.
    match /users/{userId}/tasks/{taskId}/attachments/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024;
    }

    // Per-user namespace — full read/write access for the owner only.
    match /users/{userId}/{allPaths=**} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    // Cap individual uploads at 10 MiB so a runaway client
                    // can't blow the project's free-tier storage quota.
                    && request.resource.size < 10 * 1024 * 1024
                    // Only allow image uploads under this branch.
                    && request.resource.contentType.matches('image/.*');
    }

    // Everything else is denied by default — no implicit fallthrough.
    match /{allOther=**} {
      allow read, write: if false;
    }
  }
}
